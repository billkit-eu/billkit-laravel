# Packagist builds the dist a `composer require` downloads with `git archive`,
# so everything below stays in the repository and out of installs: an
# install gets src/, config/, database/, LICENSE, README.md, CHANGELOG.md,
# SECURITY.md and composer.json. Keep this file and its copy in
# sdk/scripts/split-templates/laravel/ identical.
/.github                 export-ignore
/.gitattributes          export-ignore
/.gitignore              export-ignore
/.php-cs-fixer.dist.php  export-ignore
/bin                     export-ignore
/integration             export-ignore
/phpstan.neon            export-ignore
/phpunit.xml             export-ignore
/tests                   export-ignore
